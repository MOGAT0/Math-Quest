; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MathQuest"
config/tags=PackedStringArray("commission")
run/main_scene="uid://mexsnsd6c1h4"
config/features=PackedStringArray("4.5", "GL Compatibility")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="uid://fe4fhcelkc6s"

[audio]

general/text_to_speech=true

[autoload]

GameManager="*res://core/managers/GameManager.gd"
StoryLineManager="*res://core/managers/StoryLine_Manager.gd"
DataManager="*res://core/DataManager.gd"
db="*res://core/managers/db_editor/db_editor.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=2
mouse_cursor/custom_image="uid://bn3dw5aeg2kqq"

[editor_plugins]

enabled=PackedStringArray("res://addons/virtual_joystick_plus/plugin.cfg")

